{
  "name": "arizona-seals",
  "version": "0.0.2",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome format --write .",
    "check:format": "biome check .",
    "check:types": "turbo run check:types",
    "blueprints:plan": "pnpm dlx sanity@latest blueprints plan",
    "blueprints:deploy": "pnpm dlx sanity@latest blueprints deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@sanity/blueprints": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
